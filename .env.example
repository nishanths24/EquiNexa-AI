# .env.example
# Create a copy of this file and rename it to .env
# DO NOT commit your actual .env file.

# Optional LLM API Key (Required for live AI inference, see docs/provider_verification.md)
OPENAI_API_KEY="sk-proj-YOUR_API_KEY_HERE"
GEMINI_API_KEY="AIzaSy-YOUR_API_KEY_HERE"
GEMINI_MODEL="gemini-3.8-flash" # Default free tier capable model

# Add other environment variables here as the project requires.

# Frontend Configuration
# Base URL for the FastAPI backend used by the Vite frontend
VITE_API_URL="http://127.0.0.1:8000"
